; Engine configuration file.
config_version=5

[application]

config/name="Gang Salju"
config/description="Scene noir malam bersalju bergaya grafis awal 2000-an. Tekstur: Poly Haven (CC0)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=1
